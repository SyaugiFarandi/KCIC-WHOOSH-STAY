{
  "name": "@whoosh/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch --clear-screen=false src/server.ts",
    "dev:e2e": "dotenv -e ../../.env.e2e -- tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "dotenv -e ../../.env.test -- vitest run --config vitest.unit.config.ts",
    "test:integration": "dotenv -e ../../.env.test -- vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- tsx src/database/seed-cli.ts",
    "db:migrate:e2e": "dotenv -e ../../.env.e2e -- prisma migrate deploy",
    "db:seed:e2e": "dotenv -e ../../.env.e2e -- tsx src/database/seed-cli.ts",
    "db:verify": "dotenv -e ../../.env -- tsx src/scripts/verify-database.ts",
    "bootstrap:admin": "dotenv -e ../../.env -- tsx src/database/bootstrap-admin.ts",
    "rotate:admin": "dotenv -e ../../.env -- tsx src/database/rotate-admin-password.ts",
    "purge:demo": "dotenv -e ../../.env -- tsx src/database/purge-demo.ts",
    "employees:sync": "dotenv -e ../../.env -- tsx src/scripts/sync-employees.ts",
    "employees:seed-synthetic": "dotenv -e ../../.env -- tsx src/database/seed-synthetic-employees.ts",
    "employees:purge-synthetic": "dotenv -e ../../.env -- tsx src/database/purge-synthetic-employees.ts",
    "research:import": "dotenv -e ../../.env -- tsx src/database/import-research.ts",
    "demo:seed": "dotenv -e ../../.env -- tsx src/database/seed-dev-demo.ts"
  },
  "prisma": {
    "seed": "tsx src/database/seed-cli.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/client": "^6.19.3",
    "@whoosh/shared": "^0.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "minio": "^8.0.7",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "openid-client": "^6.9.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "read-excel-file": "^9.3.20",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.1.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
