model Reservation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingCode        String    @unique @map("booking_code") @db.VarChar(40)
  primaryEmployeeId  String    @map("primary_employee_id") @db.Uuid
  dormitoryId        String    @map("dormitory_id") @db.Uuid
  source             String    @db.VarChar(20)
  sourceReference    String?   @map("source_reference") @db.VarChar(150)
  idempotencyKey     String?   @map("idempotency_key") @db.VarChar(150)
  checkInDate        DateTime  @map("check_in_date") @db.Date
  checkOutDate       DateTime  @map("check_out_date") @db.Date
  occupantCount      Int       @map("occupant_count")
  purpose            String?
  status             String    @default("DRAFT") @db.VarChar(30)
  approvalStatus     String    @default("NOT_REQUIRED") @map("approval_status") @db.VarChar(30)
  requestedAt        DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason")
  approvedBy         String?   @map("approved_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  primaryEmployee Employee? @relation("ReservationPrimaryEmployee", fields: [primaryEmployeeId], references: [id], onDelete: Restrict)
  dormitory      Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  creator        User?     @relation("ReservationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  approver       User?     @relation("ReservationApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  guests            ReservationGuest[]
  allocations       BedAllocation[]
  events            ReservationEvent[]
  approvals         ReservationApproval[]
  checkins          CheckinRecord[]
  checkouts         CheckoutRecord[]
  qrTokens          QrToken[]
  housekeepingTasks HousekeepingTask[]
  recommendations   AccommodationRecommendation[]

  @@index([status, checkInDate, checkOutDate])
  @@index([primaryEmployeeId, createdAt(sort: Desc)])
  @@index([dormitoryId, checkInDate])
  @@index([requestedAt(sort: Desc), id])
  @@map("reservations")
}

