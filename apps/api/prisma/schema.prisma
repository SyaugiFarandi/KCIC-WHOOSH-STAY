generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oidcIssuer     String?   @map("oidc_issuer") @db.VarChar(255)
  oidcSubject    String?   @map("oidc_subject") @db.VarChar(255)
  employeeId     String?   @map("employee_id") @db.Uuid
  email          String    @unique @db.VarChar(255)
  displayName    String    @map("display_name") @db.VarChar(150)
  demoPasswordHash String? @map("demo_password_hash") @db.VarChar(255)
  passwordHash     String? @map("password_hash") @db.VarChar(255)
  telegramChatId   String? @map("telegram_chat_id") @db.VarChar(64)
  status         String    @default("ACTIVE") @db.VarChar(30)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee                 Employee?                @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  roles                    UserRole[]
  sessions                 Session[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  reservationsCreated      Reservation[]            @relation("ReservationCreatedBy")
  reservationsApproved     Reservation[]            @relation("ReservationApprovedBy")
  allocationsMade          BedAllocation[]          @relation("AllocationAllocatedBy")
  reservationEvents        ReservationEvent[]
  reservationApprovals     ReservationApproval[]
  checkinsVerified         CheckinRecord[]          @relation("CheckinVerifiedBy")
  checkoutsVerified        CheckoutRecord[]         @relation("CheckoutVerifiedBy")
  housekeepingAssigned     HousekeepingTask[]       @relation("HousekeepingAssignedTo")
  housekeepingVerified     HousekeepingTask[]       @relation("HousekeepingVerifiedBy")
  checklistItemsCompleted  HousekeepingChecklistItem[]
  ticketsReported          MaintenanceTicket[]      @relation("TicketReportedBy")
  ticketsAssigned          MaintenanceTicket[]      @relation("TicketAssignedTo")
  inventoryBlocksCreated   InventoryBlock[]         @relation("InventoryBlockCreatedBy")
  employeeSyncLogs         EmployeeSyncLog[]        @relation("EmployeeSyncInitiatedBy")
  rosterSyncRuns           RosterSyncRun[]          @relation("RosterSyncInitiatedBy")
  integrationExceptions    IntegrationException[]   @relation("ExceptionResolvedBy")
  attachments              Attachment[]
  accommodationPhotos      AccommodationPhoto[]
  researchReviews          AccommodationResearch[]  @relation("ResearchReviewedBy")
  researchEvents           ResearchEvent[]          @relation("ResearchEventActor")

  @@unique([oidcIssuer, oidcSubject])
  @@index([employeeId])
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  scopeType String   @map("scope_type") @db.VarChar(30)
  scopeId   String?  @map("scope_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model Employee {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceSystem      String    @map("source_system") @db.VarChar(50)
  externalEmployeeId String   @map("external_employee_id") @db.VarChar(100)
  employeeCode      String    @map("employee_code") @db.VarChar(50)
  fullName          String    @map("full_name") @db.VarChar(150)
  workEmail         String?   @map("work_email") @db.VarChar(255)
  departmentCode    String?   @map("department_code") @db.VarChar(50)
  departmentName    String?   @map("department_name") @db.VarChar(150)
  divisionCode      String?   @map("division_code") @db.VarChar(50)
  divisionName      String?   @map("division_name") @db.VarChar(150)
  positionCode      String?   @map("position_code") @db.VarChar(50)
  positionName      String?   @map("position_name") @db.VarChar(150)
  homeStationCode   String?   @map("home_station_code") @db.VarChar(50)
  joinDate          DateTime? @map("join_date") @db.Date
  supervisorId      String?   @map("supervisor_id") @db.Uuid
  employmentStatus  String    @map("employment_status") @db.VarChar(30)
  eligibilityStatus String    @default("UNKNOWN") @map("eligibility_status") @db.VarChar(30)
  sourceUpdatedAt   DateTime? @map("source_updated_at") @db.Timestamptz(6)
  syncedAt          DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                User[]                      @relation("UserEmployee")
  reservations         Reservation[]              @relation("ReservationPrimaryEmployee")
  reservationGuests    ReservationGuest[]
  checkins             CheckinRecord[]
  checkouts            CheckoutRecord[]
  qrTokens             QrToken[]
  rosterAssignments    RosterAssignment[]
  recommendations      AccommodationRecommendation[]
  supervisor           Employee?                   @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates         Employee[]                  @relation("EmployeeSupervisor")

  @@unique([sourceSystem, externalEmployeeId])
  @@index([employeeCode])
  @@index([fullName])
  @@index([supervisorId])
  @@map("employees")
}

model OrgReference {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         String   @db.VarChar(30)
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(150)
  status       String   @default("UNCONFIRMED") @db.VarChar(30)
  sourceSystem String   @default("SYNTHETIC") @map("source_system") @db.VarChar(50)
  description  String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type, code])
  @@index([type, status])
  @@map("org_references")
}

model EmployeeSyncLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceSystem   String    @map("source_system") @db.VarChar(50)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  status         String    @db.VarChar(30)
  fetchedCount   Int       @default(0) @map("fetched_count")
  insertedCount  Int       @default(0) @map("inserted_count")
  updatedCount   Int       @default(0) @map("updated_count")
  failedCount    Int       @default(0) @map("failed_count")
  errorSummary   String?   @map("error_summary")
  initiatedBy    String?   @map("initiated_by") @db.Uuid

  initiatedByUser User? @relation("EmployeeSyncInitiatedBy", fields: [initiatedBy], references: [id], onDelete: SetNull)

  @@index([sourceSystem, startedAt])
  @@map("employee_sync_logs")
}

model EmployeeImportBatch {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName      String    @map("file_name") @db.VarChar(255)
  status        String    @default("PREVIEWED") @db.VarChar(30)
  rowCount      Int       @default(0) @map("row_count")
  validCount    Int       @default(0) @map("valid_count")
  invalidCount  Int       @default(0) @map("invalid_count")
  insertedCount Int       @default(0) @map("inserted_count")
  updatedCount  Int       @default(0) @map("updated_count")
  errorSummary  String?   @map("error_summary")
  uploadedBy    String?   @map("uploaded_by") @db.Uuid
  committedBy   String?   @map("committed_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  committedAt   DateTime? @map("committed_at") @db.Timestamptz(6)

  rows EmployeeImportRow[]

  @@index([status, createdAt])
  @@map("employee_import_batches")
}

model EmployeeImportRow {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId    String  @map("batch_id") @db.Uuid
  rowNumber  Int     @map("row_number")
  data       Json
  errors     Json
  action     String  @db.VarChar(20)
  employeeId String? @map("employee_id") @db.Uuid

  batch EmployeeImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("employee_import_rows")
}

model MasterImportBatch {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity        String    @db.VarChar(30)
  fileName      String    @map("file_name") @db.VarChar(255)
  status        String    @default("PREVIEWED") @db.VarChar(30)
  rowCount      Int       @default(0) @map("row_count")
  validCount    Int       @default(0) @map("valid_count")
  invalidCount  Int       @default(0) @map("invalid_count")
  insertedCount Int       @default(0) @map("inserted_count")
  updatedCount  Int       @default(0) @map("updated_count")
  errorSummary  String?   @map("error_summary")
  uploadedBy    String?   @map("uploaded_by") @db.Uuid
  committedBy   String?   @map("committed_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  committedAt   DateTime? @map("committed_at") @db.Timestamptz(6)

  rows MasterImportRow[]

  @@index([entity, createdAt])
  @@map("master_import_batches")
}

model MasterImportRow {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId   String  @map("batch_id") @db.Uuid
  rowNumber Int     @map("row_number")
  data      Json
  errors    Json
  action    String  @db.VarChar(20)
  entityId  String? @map("entity_id") @db.Uuid

  batch MasterImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("master_import_rows")
}

model Location {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(150)
  description String?
  address     String?
  status      String   @default("ACTIVE") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  dormitories Dormitory[]
  researchCandidates AccommodationResearch[]

  @@index([status])
  @@map("locations")
}

model Dormitory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(40)
  name         String   @db.VarChar(150)
  description  String?
  address      String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  stationCode  String?  @map("station_code") @db.VarChar(50)
  locationId   String?  @map("location_id") @db.Uuid
  contactName  String?  @map("contact_name") @db.VarChar(150)
  contactPhone String?  @map("contact_phone") @db.VarChar(40)
  status       String   @default("ACTIVE") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid

  buildings    Building[]
  reservations Reservation[]
  photos       AccommodationPhoto[]
  location     Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  promotedFromResearch AccommodationResearch[] @relation("ResearchPromotedDormitory")

  @@index([stationCode, status])
  @@index([locationId])
  @@map("dormitories")
}

model AccommodationResearch {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId          String    @map("location_id") @db.Uuid
  name                String    @db.VarChar(200)
  address             String?
  latitude            Decimal?  @db.Decimal(10, 7)
  longitude           Decimal?  @db.Decimal(10, 7)
  distanceKm          Decimal?  @map("distance_km") @db.Decimal(6, 2)
  propertyType        String?   @map("property_type") @db.VarChar(60)
  classification      String    @default("RESEARCH_CANDIDATE") @db.VarChar(40)
  verificationStatus  String    @default("PENDING") @map("verification_status") @db.VarChar(40)
  facilities          Json?
  website             String?   @db.VarChar(500)
  contactName         String?   @map("contact_name") @db.VarChar(150)
  contactPhone        String?   @map("contact_phone") @db.VarChar(60)
  notes               String?
  promotedDormitoryId String?   @map("promoted_dormitory_id") @db.Uuid
  reviewedBy          String?   @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  location          Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  promotedDormitory Dormitory?       @relation("ResearchPromotedDormitory", fields: [promotedDormitoryId], references: [id], onDelete: SetNull)
  reviewer          User?            @relation("ResearchReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  sources           ResearchSource[]
  events            ResearchEvent[]

  @@unique([locationId, name])
  @@index([classification])
  @@index([verificationStatus])
  @@map("accommodation_research")
}

model ResearchSource {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId   String    @map("research_id") @db.Uuid
  url          String    @db.VarChar(1000)
  title        String?   @db.VarChar(300)
  sourceType   String    @map("source_type") @db.VarChar(40)
  checkedAt    DateTime  @map("checked_at") @db.Date
  photoUrl     String?   @map("photo_url") @db.VarChar(1000)
  photoRights  String?   @map("photo_rights") @db.VarChar(200)
  photoTakenAt DateTime? @map("photo_taken_at") @db.Date
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  research AccommodationResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@index([researchId])
  @@map("research_sources")
}

model ResearchEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId  String   @map("research_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(60)
  fromStatus  String?  @map("from_status") @db.VarChar(40)
  toStatus    String?  @map("to_status") @db.VarChar(40)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  research AccommodationResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  actor    User?                 @relation("ResearchEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([researchId, createdAt(sort: Desc)])
  @@map("research_events")
}

model Building {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dormitoryId String   @map("dormitory_id") @db.Uuid
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(150)
  status      String   @default("ACTIVE") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  floors    Floor[]

  @@unique([dormitoryId, code])
  @@map("buildings")
}

model Floor {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId  String   @map("building_id") @db.Uuid
  floorNumber Int      @map("floor_number")
  name        String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  building Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  rooms    Room[]

  @@unique([buildingId, floorNumber])
  @@map("floors")
}

model RoomType {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(40)
  name            String   @db.VarChar(100)
  description     String?
  defaultCapacity Int      @map("default_capacity")
  status          String   @default("ACTIVE") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rooms Room[]

  @@map("room_types")
}

model Room {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  floorId            String   @map("floor_id") @db.Uuid
  roomTypeId         String   @map("room_type_id") @db.Uuid
  roomNumber         String   @map("room_number") @db.VarChar(40)
  name               String?  @db.VarChar(100)
  description        String?
  genderPolicy       String   @default("UNSPECIFIED") @map("gender_policy") @db.VarChar(30)
  operationalStatus  String   @default("ACTIVE") @map("operational_status") @db.VarChar(30)
  housekeepingStatus String   @default("READY") @map("housekeeping_status") @db.VarChar(30)
  statusReason       String?  @map("status_reason")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  floor               Floor                @relation(fields: [floorId], references: [id], onDelete: Restrict)
  roomType            RoomType             @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  beds                Bed[]
  roomFacilities      RoomFacility[]
  inventoryBlocks     InventoryBlock[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceTickets  MaintenanceTicket[]
  photos              AccommodationPhoto[]

  @@unique([floorId, roomNumber])
  @@index([roomTypeId])
  @@index([operationalStatus, housekeepingStatus])
  @@map("rooms")
}

model Bed {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId             String   @map("room_id") @db.Uuid
  bedCode            String   @map("bed_code") @db.VarChar(40)
  label              String?  @db.VarChar(80)
  status             String   @default("ACTIVE") @db.VarChar(30)
  housekeepingStatus String   @default("READY") @map("housekeeping_status") @db.VarChar(30)
  statusReason       String?  @map("status_reason")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  room              Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  allocations       BedAllocation[]
  inventoryBlocks   InventoryBlock[]
  housekeepingTasks HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([roomId, bedCode])
  @@index([status, housekeepingStatus])
  @@map("beds")
}

model Facility {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  status      String   @default("ACTIVE") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roomFacilities RoomFacility[]

  @@map("facilities")
}

model RoomFacility {
  roomId     String  @map("room_id") @db.Uuid
  facilityId String  @map("facility_id") @db.Uuid
  quantity   Int?
  notes      String?

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@id([roomId, facilityId])
  @@map("room_facilities")
}

model InventoryBlock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId         String?  @map("room_id") @db.Uuid
  bedId          String?  @map("bed_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz(6)
  endAt          DateTime @map("end_at") @db.Timestamptz(6)
  blockType      String   @map("block_type") @db.VarChar(30)
  reason         String
  sourceTicketId String?  @map("source_ticket_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room         Room?             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  bed          Bed?              @relation(fields: [bedId], references: [id], onDelete: Restrict)
  sourceTicket MaintenanceTicket? @relation("TicketBlocks", fields: [sourceTicketId], references: [id], onDelete: SetNull)
  createdByUser User             @relation("InventoryBlockCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([roomId, startAt, endAt])
  @@index([bedId, startAt, endAt])
