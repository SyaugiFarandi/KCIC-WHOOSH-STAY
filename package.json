{
  "name": "whoosh-stay",
  "version": "0.1.0",
  "private": true,
  "description": "Whoosh Stay internal crew accommodation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @whoosh/shared && npm run build -w @whoosh/api && npm run build -w @whoosh/web",
    "typecheck": "npm run typecheck -w @whoosh/shared && npm run typecheck -w @whoosh/api && npm run typecheck -w @whoosh/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:unit -w @whoosh/api",
    "test:integration": "npm run test:integration -w @whoosh/api",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @whoosh/api",
    "db:seed": "npm run db:seed -w @whoosh/api",
    "db:verify": "npm run db:verify -w @whoosh/api",
    "employees:sync": "npm run employees:sync -w @whoosh/api",
    "dev:api": "npm run dev -w @whoosh/api",
    "dev:web": "npm run dev -w @whoosh/web"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
