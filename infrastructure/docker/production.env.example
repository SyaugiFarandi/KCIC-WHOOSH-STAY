# Production profile template. Copy to infrastructure/docker/production.env and replace every
# CHANGE_ME value. Never commit production.env. Keep the password inside DATABASE_URL in sync
# with POSTGRES_PASSWORD. NODE_ENV=production is only allowed once an official OIDC issuer exists;
# see docs/DEPLOYMENT_RUNBOOK.md.

# Compose interpolation (also passed to the containers below)
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
WEB_PORT=8080

# API runtime
NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://CHANGE_ME_PUBLIC_HOST
DATABASE_URL=postgresql://whoosh:CHANGE_ME_DB_PASSWORD@postgres:5432/whoosh_stay?schema=public
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHAR_SECRET
SESSION_TTL_HOURS=8
TRUST_PROXY=true

# Auth: production refuses mock mode.
AUTH_MODE=oidc
OIDC_ISSUER=https://CHANGE_ME_ISSUER
OIDC_CLIENT_ID=CHANGE_ME_CLIENT_ID
OIDC_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET
OIDC_REDIRECT_URI=https://CHANGE_ME_PUBLIC_HOST/api/v1/auth/callback
OIDC_SCOPE="openid profile email"

# External integrations stay disabled until official contracts are approved.
EMPLOYEE_SYNC_ENABLED=false
ROSTER_SYNC_ENABLED=false

# Object storage (service DNS name inside the Compose network).
# MINIO_ACCESS_KEY and MINIO_SECRET_KEY above are reused by the API.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_ASSETS=whoosh-stay-assets
MINIO_BUCKET_EVIDENCE=whoosh-stay-evidence

# Production refuses demo seeding.
SEED_DEMO=false
RATE_LIMIT_MAX=120
API_RATE_LIMIT_MAX=600
LOG_LEVEL=info
