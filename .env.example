# Whoosh Stay local development environment (copy to .env; never commit .env)
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5174

DATABASE_URL=postgresql://whoosh:whoosh_dev_password@localhost:5433/whoosh_stay?schema=public
SESSION_SECRET=dev-only-session-secret-change-before-production-0123456789
SESSION_TTL_HOURS=8

# mock | password | oidc
AUTH_MODE=password
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/callback
OIDC_SCOPE="openid profile email"

# Integration adapters are implemented but OFF by default. Fill credentials only when ready.
# Production refuses EMPLOYEE_SYNC_ENABLED / ROSTER_SYNC_ENABLED until contracts are approved.
# Email/Telegram without credentials keep recording MOCK_DELIVERED rows; nothing is sent.
EMPLOYEE_SYNC_ENABLED=false
ROSTER_SYNC_ENABLED=false

# HTTP employee sync (used only when EMPLOYEE_SYNC_ENABLED=true)
EMPLOYEE_SYNC_BASE_URL=
EMPLOYEE_SYNC_PATH=/employees
EMPLOYEE_SYNC_SOURCE_SYSTEM=EXTERNAL_HR
# none | bearer | api-key | basic
EMPLOYEE_SYNC_AUTH_TYPE=bearer
EMPLOYEE_SYNC_TOKEN=
EMPLOYEE_SYNC_API_KEY_HEADER=x-api-key
EMPLOYEE_SYNC_USERNAME=
EMPLOYEE_SYNC_PASSWORD=
EMPLOYEE_SYNC_TIMEOUT_MS=15000

# Email delivery (mock records simulated delivery; smtp sends real mail)
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_TIMEOUT_MS=10000

# Telegram delivery (empty token keeps the mock delivery path)
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=10000

# Set true only behind a trusted reverse proxy so X-Forwarded-For is honoured.
TRUST_PROXY=false

# MinIO (development object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9110
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=whoosh_minio
MINIO_SECRET_KEY=whoosh_minio_password
MINIO_BUCKET_ASSETS=whoosh-stay-assets
MINIO_BUCKET_EVIDENCE=whoosh-stay-evidence

# Demo data is synthetic and clearly labelled; never enable with real data.
SEED_DEMO=true

# Upload limits (bytes) enforced by the API.
ATTACHMENT_MAX_BYTES=5242880
GALLERY_PHOTO_MAX_BYTES=12582912

RATE_LIMIT_MAX=1000
API_RATE_LIMIT_MAX=600
LOG_LEVEL=info
